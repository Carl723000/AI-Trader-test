# AI-Trader Live Trading Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================
# AI Model API Configuration
# ============================================
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Alpaca Trading API (US Stocks)
# ============================================
# Get API keys from: https://alpaca.markets/

# Paper Trading (Recommended for testing)
ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_API_SECRET=your_alpaca_paper_api_secret

# Live Trading (Use with caution!)
# ALPACA_API_KEY=your_alpaca_live_api_key
# ALPACA_API_SECRET=your_alpaca_live_api_secret

# ============================================
# Binance API (Cryptocurrency)
# ============================================
# Get API keys from: https://www.binance.com/en/my/settings/api-management

# Testnet (Recommended for testing)
BINANCE_API_KEY=your_binance_testnet_api_key
BINANCE_API_SECRET=your_binance_testnet_api_secret

# Live Trading (Use with caution!)
# BINANCE_API_KEY=your_binance_live_api_key
# BINANCE_API_SECRET=your_binance_live_api_secret

# ============================================
# Market Data APIs
# ============================================
# Alpha Vantage (for additional market data)
ALPHAADVANTAGE_API_KEY=your_alphavantage_key

# Jina AI (for market research)
JINA_API_KEY=your_jina_api_key

# ============================================
# Trading Configuration
# ============================================
# Broker type: alpaca, binance
BROKER_TYPE=alpaca

# Trading mode: paper (simulation), live (real money)
TRADING_MODE=paper

# ============================================
# Risk Management
# ============================================
# Emergency stop file path (create this file to stop trading)
EMERGENCY_STOP_FILE=data/emergency_stop.flag

# ============================================
# Logging and Monitoring
# ============================================
LOG_LEVEL=INFO
LOG_FILE=data/live_logs/trading.log

# ============================================
# Notifications (Optional)
# ============================================
# Email notifications
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=your_email@gmail.com

# Webhook notifications
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-url.com/notify

# ============================================
# Advanced Settings
# ============================================
# MCP service ports (usually don't need to change)
MATH_HTTP_PORT=8000
SEARCH_HTTP_PORT=8001
TRADE_HTTP_PORT=8002
GETPRICE_HTTP_PORT=8003
CRYPTO_HTTP_PORT=8005

# Agent settings
AGENT_MAX_STEP=30
RUNTIME_ENV_PATH=./runtime_env.json
